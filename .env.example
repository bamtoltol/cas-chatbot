# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 아래 값을 채우세요.
# .env 파일은 절대 GitHub에 올리지 않습니다. (.gitignore에 등록되어 있음)

GEMINI_API_KEY=여기에_발급받은_API키

# 답변 생성 모델 (Google AI Studio 모델 목록에서 확인)
GEMINI_MODEL=gemini-3.8-flash

# 기본 모델이 붐빌 때(503) 순서대로 시도할 대체 모델
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# 매뉴얼 검색용 임베딩 모델
EMBED_MODEL=gemini-embedding-2-preview
